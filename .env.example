# Docker-скрипт сам создаёт ADMIN_ACCESS_TOKEN и OPENROUTER_KEY_ENC_KEY в .env.
# Этот файл — справка по дополнительным настройкам, не готовый .env.
NODE_ENV=production
COOKIE_SECURE=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Домены без протокола, пути и порта, через запятую.
TURNSTILE_HOSTNAMES=
TURNSTILE_TEST_MODE=false
# IP/CIDR только ваших доверенных reverse proxy; без прокси оставьте пустым.
TRUST_PROXY=
