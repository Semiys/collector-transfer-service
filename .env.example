# Docker-скрипт сам создаёт ADMIN_ACCESS_TOKEN и AI_KEY_ENC_KEY в .env.
# Прежний OPENROUTER_KEY_ENC_KEY тоже поддерживается как ключ шифрования.
# API-ключ Groq добавляется через админку, а не в этот файл.
# Этот файл — справка по дополнительным настройкам, не готовый .env.
NODE_ENV=production
COOKIE_SECURE=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Домены без протокола, пути и порта, через запятую.
TURNSTILE_HOSTNAMES=
TURNSTILE_TEST_MODE=false
# Только для локального Docker с портом, опубликованным на 127.0.0.1.
# Скрипты start-docker задают флаг сами; на публичном сервере оставить false.
TURNSTILE_TEST_DOCKER_LOCAL=false
# IP/CIDR только ваших доверенных reverse proxy; без прокси оставьте пустым.
TRUST_PROXY=
